{
  "name": "@trailpack-ui/react",
  "version": "0.1.0",
  "description": "React components, hooks and utilities for Trailpack projects, built on @trailpack-ui/theme.",
  "homepage": "https://github.com/tobia-codes/trailpack-ui/tree/main/packages/react",
  "bugs": "https://github.com/tobia-codes/trailpack-ui/issues",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobia-codes/trailpack-ui.git",
    "directory": "packages/react"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "default": "./dist/components/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "default": "./dist/utils/index.js"
    },
    "./styles.css": {
      "types": "./dist/styles.css.d.ts",
      "default": "./dist/styles.css"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "dev": "storybook dev -p 6007",
    "build:storybook": "storybook build",
    "lint": "oxlint",
    "test": "vitest run --passWithNoTests",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.5.4",
    "@storybook/react-vite": "^10.5.5",
    "@trailpack-ui/theme": "workspace:^",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vanilla-extract/css": "^1.21.2",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.5",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "@trailpack-ui/theme": "^0.1.0",
    "react": "^19.0.0"
  }
}
