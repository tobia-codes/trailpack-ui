{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "declaration": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@tests/*": ["./tests/*"]
    }
  },
  "include": ["src", "tests", ".storybook/**/*", "vite.config.ts"]
}
