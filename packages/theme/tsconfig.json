{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "declaration": false,
    "noEmit": true,
    "jsx": "react-jsx",
    // `scripts/` runs on Node's TypeScript stripping, which resolves imports
    // literally and so needs the `.ts` extension written out.
    "allowImportingTsExtensions": true
  },
  "include": ["src", "scripts", ".storybook/**/*", "vite.config.ts"]
}
